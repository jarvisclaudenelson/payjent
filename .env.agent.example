# Payjent agent owner integration example.
# Copy to your agent's untracked .env or secret manager and replace placeholders.

# Hosted usage: set this to your deployed Payjent API base URL.
# Local usage with a running API: http://127.0.0.1:8000
PAYJENT_BASE_URL="https://payjent.example.com"

# Agent/bot identity registered with Payjent. This is not secret.
PAYJENT_BOT_ID="agent_<your_agent_id>"

# Bot API key for server-side agent code only. Never expose this in a browser,
# public chat, repository, or client-side bundle.
PAYJENT_BOT_KEY="payjent_<redacted_bot_key>"

# Optional local/demo only: operator key for mock payment endpoints while testing.
# Hosted production payment flows should use real payment webhooks/rails instead.
# Do not deploy this into public agent runtime paths unless intentionally needed
# for a private operator tool.
# PAYJENT_OPERATOR_KEY="payjent_<redacted_operator_key>"
