PAYJENT_ENV=local
PAYJENT_DATABASE_URL=sqlite:///./payjent.db
PAYJENT_SIGNING_SECRET=dev-only-change-me
PAYJENT_DEV_MODE=true
PAYJENT_MOCK_PROVIDER_ENABLED=true
PAYJENT_CHECKOUT_PROVIDER=mock
PAYJENT_PUBLIC_BASE_URL=http://localhost:8000
PAYJENT_GRANT_TTL_SECONDS=900

# Disposable local/dev reset only. In production, reset-db refuses unless this is true.
PAYJENT_ALLOW_UNSAFE_DB_RESET=false

# Direct-host production checklist (set via real secret manager/environment, not this file):
# PAYJENT_ENV=production
# PAYJENT_SIGNING_SECRET=<strong-random-signing-secret>
# PAYJENT_PUBLIC_BASE_URL=https://<your-payjent-host>
# PAYJENT_DEV_MODE=false
# PAYJENT_MOCK_PROVIDER_ENABLED=false

# Stripe Checkout (optional; install with `pip install -e '.[stripe]'` for live calls)
# PAYJENT_CHECKOUT_PROVIDER=stripe
# PAYJENT_STRIPE_SECRET_KEY=<stripe-secret-key>
# PAYJENT_STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
# Configure Stripe webhook URL: https://<your-payjent-host>/api/v1/webhooks/stripe
# Optional templates support {payment_session_id}
# PAYJENT_STRIPE_SUCCESS_URL_TEMPLATE=https://<your-payjent-host>/status/{payment_session_id}?checkout=success
# PAYJENT_STRIPE_CANCEL_URL_TEMPLATE=https://<your-payjent-host>/pay/{payment_session_id}?checkout=cancelled
# Link one-time credential rail (experimental). MCP-first; link-cli fallback should be
# authenticated out-of-band. Payjent stores no Link secrets here.
# PAYJENT_CHECKOUT_PROVIDER=link
