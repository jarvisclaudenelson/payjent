PAYJENT_DATABASE_URL=sqlite:///./payjent.db
PAYJENT_SIGNING_SECRET=dev-only-change-me
PAYJENT_DEV_MODE=true
PAYJENT_MOCK_PROVIDER_ENABLED=true
PAYJENT_CHECKOUT_PROVIDER=mock
PAYJENT_PUBLIC_BASE_URL=http://localhost:8000
# Stripe Checkout (optional; install with `pip install -e '.[stripe]'` for live calls)
# PAYJENT_CHECKOUT_PROVIDER=stripe
# PAYJENT_STRIPE_SECRET_KEY=sk_test_...
# PAYJENT_STRIPE_WEBHOOK_SECRET=whsec_...
# Optional templates support {payment_session_id}
# PAYJENT_STRIPE_SUCCESS_URL_TEMPLATE=http://localhost:8000/status/{payment_session_id}?checkout=success
# PAYJENT_STRIPE_CANCEL_URL_TEMPLATE=http://localhost:8000/pay/{payment_session_id}?checkout=cancelled
PAYJENT_GRANT_TTL_SECONDS=900
